{
  "name": "Rozaneh-tab",
  "description": "A light, private new tab with clock, calendar and weather.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "adhan": "^4.4.4"
  }
}
